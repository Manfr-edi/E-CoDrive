<?xml version='1.0' encoding='UTF-8'?>
<configuration xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://sumo.dlr.de/xsd/sumoConfiguration.xsd">
  <input>
    <net-file value="net/bologna.net.xml" />
    <route-files value="carlavtypes.rou.xml, egovtype.xml, rou/bologna.rou.xml" />
    </input>
  <processing>
    <time-to-teleport value="-1" />
    <tls.all-off value="true" />
    </processing>
  <gui_only>
    <gui-settings-file value="viewsettings.xml" />
    </gui_only>
  <time>
    <begin value="0" />
    <end value="3600.0" />
    </time>
  <output>
    <battery-output value="output/battery.out.xml" />
    <tripinfo-output value="output/tripinfos.xml" />
    <vehroute-output value="output/vehroute.xml" />
    <summary-output value="output/summary.xml" />
    <edgedata-output value="output/edgedata-output.xml" />
    <!-- <emission-output value="output/emission-output.xml" /> -->
    </output>
  </configuration>
